# Keeps whitespace consistent for anyone reviewing this repository in an editor
# that is not the one it was written in. Rust's own formatting is `cargo fmt`'s
# job; this covers the files it does not touch.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{S,s}]
indent_size = 4
